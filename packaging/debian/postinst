#!/bin/sh
set -e

case "$1" in
    configure)
        if ! getent group centralium >/dev/null 2>&1; then
            groupadd --system centralium
        fi
        if ! getent passwd centralium >/dev/null 2>&1; then
            useradd --system --gid centralium --home-dir /var/lib/centralium \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Centralium EDR Agent" centralium
        fi

        install -d -m 0700 -o centralium -g centralium /var/lib/centralium
        install -d -m 0750 -o centralium -g centralium /var/log/centralium
        install -d -m 0750 -o root -g centralium /etc/centralium

        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null 2>&1 || true
            systemctl enable centralium.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
